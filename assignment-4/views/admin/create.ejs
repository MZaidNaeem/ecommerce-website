<div class="page-header">
  <h1 class="page-title">Add New Product</h1>
  <a href="/admin" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
</div>

<div class="card form-container">
  <form action="/admin/create" method="POST" enctype="multipart/form-data">
    
    <div class="form-row">
      <div class="form-group">
        <label for="name" class="form-label">Product Name *</label>
        <input type="text" id="name" name="name" class="form-control" required placeholder="e.g. Vintage Leather Jacket">
      </div>
      <div class="form-group">
        <label for="category" class="form-label">Category *</label>
        <input type="text" id="category" name="category" class="form-control" required placeholder="e.g. Clothing">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="price" class="form-label">Price ($) *</label>
        <input type="number" id="price" name="price" class="form-control" step="0.01" min="0" required placeholder="0.00">
      </div>
      <div class="form-group">
        <label for="stock" class="form-label">Stock Quantity</label>
        <input type="number" id="stock" name="stock" class="form-control" min="0" value="0">
      </div>
      <div class="form-group">
        <label for="rating" class="form-label">Rating (0-5)</label>
        <input type="number" id="rating" name="rating" class="form-control" step="0.1" min="0" max="5" value="0">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="form-label">Primary Image (Image 1)</label>
        <div class="file-input-wrapper">
          <input type="file" id="image1" name="image1" accept="image/*" class="form-control" style="padding: 9px;">
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Secondary Image (Image 2 - Hover)</label>
        <div class="file-input-wrapper">
          <input type="file" id="image2" name="image2" accept="image/*" class="form-control" style="padding: 9px;">
        </div>
      </div>
    </div>

    <div class="form-group" style="margin-top: 32px;">
      <button type="submit" class="btn btn-primary" style="padding: 12px 24px; font-size: 1rem;"><i class="fa-solid fa-save"></i> Save Product</button>
    </div>

  </form>
</div>
