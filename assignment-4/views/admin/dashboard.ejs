<div class="page-header">
  <h1 class="page-title">Products Dashboard</h1>
  <a href="/admin/create" class="btn btn-primary"><i class="fa-solid fa-plus"></i> Add New Product</a>
</div>

<div class="card">
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th class="product-img-cell">Image</th>
          <th>Name</th>
          <th>Category</th>
          <th>Price</th>
          <th>Stock</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (typeof products !== 'undefined' && products.length > 0) { %>
          <% products.forEach(product => { %>
            <tr>
              <td>
                <% if (product.image1) { %>
                  <img src="<%= product.image1 %>" alt="<%= product.name %>" class="product-thumb">
                <% } else { %>
                  <div class="product-thumb" style="background: #e5e7eb; display:flex; align-items:center; justify-content:center;">
                    <i class="fa-solid fa-image" style="color: #9ca3af;"></i>
                  </div>
                <% } %>
              </td>
              <td><strong><%= product.name %></strong></td>
              <td><%= product.category %></td>
              <td>$<%= (product.price !== undefined && product.price !== null) ? Number(product.price).toFixed(2) : '0.00' %></td>
              <td>
                <% if (product.stock && product.stock > 0) { %>
                  <span style="color: var(--admin-success); font-weight: 500;">
                    <%= product.stock %>
                  </span>
                <% } else { %>
                  <span style="color: var(--admin-danger); font-weight: 500;">
                    Out of Stock
                  </span>
                <% } %>
              </td>
              <td>
                <div class="actions">
                  <a href="/admin/edit/<%= product._id %>" class="btn btn-secondary btn-sm"><i class="fa-solid fa-pen"></i> Edit</a>
                  <form action="/admin/delete/<%= product._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');" style="display:inline;">
                    <button type="submit" class="btn btn-danger btn-sm"><i class="fa-solid fa-trash"></i> Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 48px;">
              <p style="color: var(--admin-text-light); margin-bottom: 16px;">No products found.</p>
              <a href="/admin/create" class="btn btn-primary">Add your first product</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
