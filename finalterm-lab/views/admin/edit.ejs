<div class="page-header">
  <h1 class="page-title">Edit Product: <%= product.name %></h1>
  <a href="/admin" class="btn btn-secondary"><i class="fa-solid fa-arrow-left"></i> Back to Dashboard</a>
</div>

<div class="card form-container">
  <form action="/admin/edit/<%= product._id %>?_method=PUT" method="POST" enctype="multipart/form-data">
    
    <div class="form-row">
      <div class="form-group">
        <label for="name" class="form-label">Product Name *</label>
        <input type="text" id="name" name="name" class="form-control" required value="<%= product.name %>">
      </div>
      <div class="form-group">
        <label for="category" class="form-label">Category *</label>
        <input type="text" id="category" name="category" class="form-control" required value="<%= product.category %>">
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="price" class="form-label">Price ($) *</label>
        <input type="number" id="price" name="price" class="form-control" step="0.01" min="0" required value="<%= product.price %>">
      </div>
      <div class="form-group">
        <label for="stock" class="form-label">Stock Quantity</label>
        <input type="number" id="stock" name="stock" class="form-control" min="0" value="<%= product.stock %>">
      </div>
      <div class="form-group">
        <label for="rating" class="form-label">Rating (0-5)</label>
        <input type="number" id="rating" name="rating" class="form-control" step="0.1" min="0" max="5" value="<%= product.rating %>">
      </div>
    </div>

    <div class="form-row" style="margin-bottom: 24px;">
      <div class="form-group" style="flex: 1;">
        <label class="form-label">Primary Image (Image 1)</label>
        <% if (product.image1) { %>
          <div style="margin-bottom: 12px;">
            <img src="<%= product.image1 %>" alt="Current Image 1" style="height: 100px; border-radius: 4px; border: 1px solid var(--admin-border);">
            <p style="font-size: 0.8rem; color: var(--admin-text-light);">Current image</p>
          </div>
        <% } %>
        <div class="file-input-wrapper">
          <input type="file" id="image1" name="image1" accept="image/*" class="form-control" style="padding: 9px;">
          <p style="font-size: 0.8rem; color: var(--admin-text-light); margin-top: 4px;">Leave blank to keep current image.</p>
        </div>
      </div>
      
      <div class="form-group" style="flex: 1;">
        <label class="form-label">Secondary Image (Image 2)</label>
        <% if (product.image2) { %>
          <div style="margin-bottom: 12px;">
            <img src="<%= product.image2 %>" alt="Current Image 2" style="height: 100px; border-radius: 4px; border: 1px solid var(--admin-border);">
            <p style="font-size: 0.8rem; color: var(--admin-text-light);">Current image</p>
          </div>
        <% } %>
        <div class="file-input-wrapper">
          <input type="file" id="image2" name="image2" accept="image/*" class="form-control" style="padding: 9px;">
          <p style="font-size: 0.8rem; color: var(--admin-text-light); margin-top: 4px;">Leave blank to keep current image.</p>
        </div>
      </div>
    </div>

    <div class="form-group" style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--admin-border);">
      <button type="submit" class="btn btn-primary" style="padding: 12px 24px; font-size: 1rem;"><i class="fa-solid fa-save"></i> Update Product</button>
    </div>

  </form>
</div>
