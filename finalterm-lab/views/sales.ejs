<div class="sales-dashboard-container" style="padding: 20px;">
    <h2><i class="fa-solid fa-chart-line"></i> Real-Time Sales Dashboard</h2>
    <p>This dashboard automatically updates every 10 seconds.</p>

    <div class="dashboard-cards" style="display: flex; gap: 20px; margin-top: 20px; flex-wrap: wrap;">
        <div class="card" style="flex: 1; min-width: 200px; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center;">
            <h3 style="margin-bottom: 15px; color: #555;">Total Revenue</h3>
            <p id="total-revenue" style="font-size: 2.2em; font-weight: bold; color: #2ecc71; margin: 0;">Rs. <%= totalRevenue %></p>
        </div>
        <div class="card" style="flex: 1; min-width: 200px; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center;">
            <h3 style="margin-bottom: 15px; color: #555;">Total Orders</h3>
            <p id="total-orders" style="font-size: 2.2em; font-weight: bold; color: #3498db; margin: 0;"><%= totalOrders %></p>
        </div>
        <div class="card" style="flex: 1; min-width: 200px; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); text-align: center;">
            <h3 style="margin-bottom: 15px; color: #555;">Top-Selling Product</h3>
            <p id="top-product" style="font-size: 1.5em; font-weight: bold; color: #9b59b6; margin: 0; min-height: 2.2em; display: flex; align-items: center; justify-content: center;"><%= topProduct %></p>
            <small id="top-product-qty" style="display: block; margin-top: 10px; color: #777;">Sold: <%= topProductQuantity %> units</small>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function() {
        // Poll every 10 seconds (10000 ms)
        setInterval(function() {
            $.getJSON('/api/sales-data', function(data) {
                // Update DOM elements with new data
                $('#total-revenue').text('Rs. ' + data.totalRevenue);
                $('#total-orders').text(data.totalOrders);
                $('#top-product').text(data.topProduct);
                $('#top-product-qty').text('Sold: ' + data.topProductQuantity + ' units');
            }).fail(function(jqxhr, textStatus, error) {
                console.error("Request Failed: " + textStatus + ", " + error);
            });
        }, 10000);
    });
</script>
