<link rel="stylesheet" href="/css/products.css" />

<!-- ══════════════ Page Title ══════════════ -->
    <div class="catalog-hero">
      <h1>ALL PRODUCTS</h1>
      <p><%= total %> item<%= total !== 1 ? 's' : '' %> found</p>
    </div>

    <!-- ══════════════ Filter / Search Bar ══════════════ -->
    <form class="filter-bar" method="GET" action="/products">

      <!-- Search -->
      <div class="filter-group filter-search">
        <label for="search">Search</label>
        <div class="search-input-wrap">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input
            type="text"
            id="search"
            name="search"
            placeholder="Search products…"
            value="<%= filters.search %>"
          />
        </div>
      </div>

      <!-- Category -->
      <div class="filter-group">
        <label for="category">Category</label>
        <select id="category" name="category">
          <option value="">All Categories</option>
          <% categories.forEach(cat => { %>
            <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
          <% }) %>
        </select>
      </div>

      <!-- Price Range -->
      <div class="filter-group filter-price">
        <label>Price Range (RS.)</label>
        <div class="price-inputs">
          <input
            type="number"
            name="minPrice"
            placeholder="Min"
            min="0"
            value="<%= filters.minPrice || '' %>"
          />
          <span>–</span>
          <input
            type="number"
            name="maxPrice"
            placeholder="Max"
            min="0"
            value="<%= filters.maxPrice || '' %>"
          />
        </div>
      </div>

      <!-- Sort -->
      <div class="filter-group">
        <label for="sortBy">Sort By</label>
        <select id="sortBy" name="sortBy">
          <option value="default"    <%= filters.sortBy === 'default'    ? 'selected' : '' %>>Default</option>
          <option value="price_asc"  <%= filters.sortBy === 'price_asc'  ? 'selected' : '' %>>Price: Low → High</option>
          <option value="price_desc" <%= filters.sortBy === 'price_desc' ? 'selected' : '' %>>Price: High → Low</option>
          <option value="rating"     <%= filters.sortBy === 'rating'     ? 'selected' : '' %>>Top Rated</option>
          <option value="name"       <%= filters.sortBy === 'name'       ? 'selected' : '' %>>Name A – Z</option>
        </select>
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn-apply">Apply</button>
        <a href="/products" class="btn-clear">Clear</a>
      </div>

    </form>
    <!-- ══════════════ Filter Bar End ══════════════ -->

    <!-- ══════════════ Product Grid ══════════════ -->
    <% if (products.length === 0) { %>
      <div class="no-results">
        <i class="fa-solid fa-box-open"></i>
        <p>No products match your filters.</p>
        <a href="/products" class="btn-apply">View All Products</a>
      </div>
    <% } else { %>
      <div class="catalog-grid">
        <% products.forEach(product => { %>
          <div class="catalog-card">
            <!-- Product image -->
            <div class="catalog-card-img product-img">
              <% if (product.image1) { %>
                <img class="img-1" src="<%= product.image1 %>" alt="<%= product.name %>">
                <% if (product.image2) { %>
                  <img class="img-2" src="<%= product.image2 %>" alt="<%= product.name %>">
                <% } %>
              <% } else { %>
                <div class="img-placeholder">
                  <i class="fa-solid fa-shirt"></i>
                </div>
              <% } %>
              <div class="card-overlay">
                <button class="btn-wishlist"><i class="fa-solid fa-heart"></i></button>
                <button class="btn-quick-view">Quick View</button>
              </div>
            </div>

            <div class="catalog-card-body">
              <p class="card-category"><%= product.category %></p>
              <h3 class="card-name"><%= product.name %></h3>

              <!-- Star Rating -->
              <div class="card-rating" aria-label="Rating: <%= product.rating %> out of 5">
                <% for (let i = 1; i <= 5; i++) { %>
                  <% if (i <= Math.floor(product.rating)) { %>
                    <i class="fa-solid fa-star"></i>
                  <% } else if (i - product.rating < 1 && i - product.rating > 0) { %>
                    <i class="fa-solid fa-star-half-stroke"></i>
                  <% } else { %>
                    <i class="fa-regular fa-star"></i>
                  <% } %>
                <% } %>
                <span class="rating-value">(<%= product.rating.toFixed(1) %>)</span>
              </div>

              <div class="card-footer">
                <span class="card-price">RS. <%= product.price.toLocaleString() %>.00</span>
                <span class="card-stock <%= product.stock < 10 ? 'low-stock' : '' %>">
                  <% if (product.stock === 0) { %>
                    Out of Stock
                  <% } else if (product.stock < 10) { %>
                    Only <%= product.stock %> left
                  <% } else { %>
                    In Stock
                  <% } %>
                </span>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
    <!-- ══════════════ Product Grid End ══════════════ -->

    <!-- ══════════════ Pagination ══════════════ -->
    <% if (totalPages > 1) { %>
      <%
        // Build a query string that preserves all filters when changing page
        function pageUrl(p) {
          const params = new URLSearchParams();
          if (filters.search)   params.set('search',   filters.search);
          if (filters.category) params.set('category', filters.category);
          if (filters.minPrice) params.set('minPrice', filters.minPrice);
          if (filters.maxPrice) params.set('maxPrice', filters.maxPrice);
          if (filters.sortBy && filters.sortBy !== 'default') params.set('sortBy', filters.sortBy);
          params.set('page', p);
          return '/products?' + params.toString();
        }

        // Window: show up to 5 page numbers centred on current page
        const window = 2;
        const startPage = Math.max(1, currentPage - window);
        const endPage   = Math.min(totalPages, currentPage + window);
      %>
      <nav class="pagination" aria-label="Product pages">

        <!-- Previous -->
        <% if (currentPage > 1) { %>
          <a class="page-btn" href="<%= pageUrl(currentPage - 1) %>">
            <i class="fa-solid fa-chevron-left"></i> Prev
          </a>
        <% } else { %>
          <span class="page-btn disabled"><i class="fa-solid fa-chevron-left"></i> Prev</span>
        <% } %>

        <!-- First page + ellipsis -->
        <% if (startPage > 1) { %>
          <a class="page-btn" href="<%= pageUrl(1) %>">1</a>
          <% if (startPage > 2) { %><span class="page-ellipsis">…</span><% } %>
        <% } %>

        <!-- Page number buttons -->
        <% for (let p = startPage; p <= endPage; p++) { %>
          <a
            class="page-btn <%= p === currentPage ? 'active' : '' %>"
            href="<%= pageUrl(p) %>"
            aria-current="<%= p === currentPage ? 'page' : '' %>"
          ><%= p %></a>
        <% } %>

        <!-- Last page + ellipsis -->
        <% if (endPage < totalPages) { %>
          <% if (endPage < totalPages - 1) { %><span class="page-ellipsis">…</span><% } %>
          <a class="page-btn" href="<%= pageUrl(totalPages) %>"><%= totalPages %></a>
        <% } %>

        <!-- Next -->
        <% if (currentPage < totalPages) { %>
          <a class="page-btn" href="<%= pageUrl(currentPage + 1) %>">
            Next <i class="fa-solid fa-chevron-right"></i>
          </a>
        <% } else { %>
          <span class="page-btn disabled">Next <i class="fa-solid fa-chevron-right"></i></span>
        <% } %>

      </nav>

      <p class="pagination-info">
        Page <%= currentPage %> of <%= totalPages %> &nbsp;·&nbsp;
        Showing <%= (currentPage - 1) * 8 + 1 %>–<%= Math.min(currentPage * 8, total) %> of <%= total %> products
      </p>
    <% } %>
    <!-- ══════════════ Pagination End ══════════════ -->