<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Panel | Lama Retail</title>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <!-- FontAwesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  
  <!-- Custom Admin CSS -->
  <link rel="stylesheet" href="/css/admin.css">
  
  <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body>
  
  <div class="admin-wrapper">
    <!-- Sidebar -->
    <aside class="admin-sidebar" id="sidebar">
      <div class="sidebar-header">
        <h2><i class="fa-solid fa-store"></i> Lama Admin</h2>
        <button id="close-sidebar" class="mobile-only"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <nav class="sidebar-nav">
        <ul>
          <li><a href="/admin" class="active"><i class="fa-solid fa-gauge"></i> Dashboard</a></li>
          <li><a href="/admin/create"><i class="fa-solid fa-plus"></i> Add Product</a></li>
          <li><a href="/" target="_blank"><i class="fa-solid fa-arrow-up-right-from-square"></i> View Store</a></li>
        </ul>
      </nav>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
      <header class="admin-header">
        <button id="open-sidebar" class="mobile-only"><i class="fa-solid fa-bars"></i></button>
        <div class="header-user">
          <span><%= typeof currentUser !== 'undefined' && currentUser ? currentUser.name : 'Admin User' %></span>
          <div class="avatar"><i class="fa-solid fa-user"></i></div>
          <a href="/logout" style="margin-left:15px;color:red;text-decoration:none;"><i class="fa-solid fa-right-from-bracket"></i> Logout</a>
        </div>
      </header>

      <main class="admin-content">
        <!-- Flash Messages -->
        <% if (typeof success_messages !== 'undefined' && success_messages.length > 0) { %>
            <div class="flash-message success" style="padding:15px;margin-bottom:20px;background-color:#d4edda;color:#155724;border-radius:4px;">
                <%= success_messages[0] %>
            </div>
        <% } %>
        <% if (typeof error_messages !== 'undefined' && error_messages.length > 0) { %>
            <div class="flash-message error" style="padding:15px;margin-bottom:20px;background-color:#f8d7da;color:#721c24;border-radius:4px;">
                <%= error_messages[0] %>
            </div>
        <% } %>
        
        <%- body %>
      </main>
    </div>
  </div>

  <%- typeof script !== 'undefined' ? script : '' %>
  <script>
    // Responsive sidebar toggle
    const sidebar = document.getElementById('sidebar');
    const openBtn = document.getElementById('open-sidebar');
    const closeBtn = document.getElementById('close-sidebar');

    openBtn.addEventListener('click', () => {
      sidebar.classList.add('open');
    });

    closeBtn.addEventListener('click', () => {
      sidebar.classList.remove('open');
    });
  </script>
</body>
</html>
